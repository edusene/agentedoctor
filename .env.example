# === API de WhatsApp (AutoZap; WhatsApp do consultorio) ===
WHATSAPI_KEY=sk_live_xxx
WHATSAPI_PHONE_NUMBER_ID=cole_o_phone_number_id_aqui
WHATSAPI_URL=https://eduwhatsapi-elpj.onrender.com/api/v1
WHATSAPI_WEBHOOK_SECRET=whsec_xxx

# === Servidor ===
WEBHOOK_URL=https://SEU-DOMINIO/webhook
PORT=5000

# === OpenAI ===
OPENAI_API_KEY=cole_a_api_key_da_openai_aqui
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# 0.0 = sem variacao de redacao. As respostas criticas ja sao travadas em codigo.
OPENAI_TEMPERATURE=0.0

# === Buffer / Historico ===
BUFFER_SECONDS=0
MAX_HISTORY=20

# === Banco de dados ===
# Supabase (Transaction pooler). Senha com caracteres especiais em percent-encoding.
DB_DRIVER=postgresql
DATABASE_URL=postgresql://postgres.SUA_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Desenvolvimento offline / rollback:
# DB_DRIVER=sqlite
# DB_PATH=secretaria.db

# === Painel ===
ADMIN_USER=admin
ADMIN_PASSWORD=
# Gere com: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# === Consultorio (secao 20 da base: preencher antes da producao) ===
# Vazio = o agente responde que a equipe confirma a informacao; nunca inventa.
TZ_OFFSET_HORAS=-3
AGENTE_NOME=
CLINICA_ENDERECO=
CLINICA_HORARIO=
CLINICA_CONVENIOS=
CLINICA_VALOR_AVALIACAO=
CLINICA_ORIENTACOES=

# === Google Calendar (opcional) ===
# Sem estas duas, a Agenda funciona so no painel. Crie um "ID do cliente OAuth"
# (Aplicativo da Web) no Google Cloud com o redirect:
#   https://SEU-DOMINIO/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://SEU-DOMINIO/api/google/callback
# GOOGLE_CALENDAR_ID=primary
